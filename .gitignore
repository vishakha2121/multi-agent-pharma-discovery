*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
.\#*

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# Eclipse
.project
.classpath
.cproject
.settings/

# ============================================
# 💻 OPERATING SYSTEM
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
Icon?

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Linux
*~
.directory
.Trash-*
.nfs*

# ============================================
# 📊 LOGS
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*
backend/logs/
*.log.*

# ============================================
# 📁 UPLOADS & GENERATED FILES
# ============================================
uploads/
backend/data/uploads/*
!backend/data/uploads/.gitkeep

reports/
backend/data/reports/*
!backend/data/reports/.gitkeep

temp/
tmp/
*.tmp
*.temp

# Generated molecules / output files
*.pdb
*.mol
*.sdf
*.mol2
generated/
output/
exports/

