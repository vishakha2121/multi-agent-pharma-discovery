.env
.env.local
.env.development
.env.production
.env.test
*.env
!.env.example
secrets.json
credentials.json
*.pem
*.key

# ============================================
# 🐍 PYTHON / BACKEND
# ============================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
ENV/
.venv/
virtualenv/
backend/venv/
backend/env/

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
