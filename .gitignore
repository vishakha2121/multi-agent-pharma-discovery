.scrapy

# ============================================
# 🗄️ DATABASE (SQLite & others)
# ============================================
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal
pharma.db
backend/data/pharma.db
backend/data/*.db

# Keep empty folders in git
!backend/data/uploads/.gitkeep
!backend/data/reports/.gitkeep
!database/backups/.gitkeep

# ============================================
# 📦 NODE / FRONTEND (React, Vite, Tailwind)
# ============================================
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite / Build output
dist/
dist-ssr/
build/
frontend/dist/
frontend/build/
.vite/

# Cache
.cache/
.parcel-cache/
.npm/
.yarn/
.pnp.*
.yarn-integrity

